// Skyro Obedy — school canteen lunch ordering.
// Simplified hackathon build: raw integer balance on Account (no ledger),
// no chat, no announcement read-receipts, no weekly menu template.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  MANAGER
}

enum MealCategory {
  MEAT
  POULTRY
  VEGETARIAN
  FISH
  SOUP_DESSERT
}

enum OrderStatus {
  OPEN
  ORDERED
  CHANGED
  CANCELLED
  SERVED
  AUTO_CANCELLED
}

/// A person in the system: student or canteen manager.
/// `id` is our business key; `username` is the login handle.
/// `balanceCents` is the whole wallet: no ledger table, one int.
model Account {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String? // argon2id hash of the password (Bun.password, salted)
  role         Role
  name         String
  active       Boolean  @default(true)
  classCode    String? // "3.A", students only
  balanceCents Int      @default(0)
  createdAt    DateTime @default(now())

  /// First-login setup: when passwordHash is null the account is claimed
  /// with this single-use code (POST /auth/claim), cleared once set.
  claimCode        String?
  claimCodeExpires DateTime?

  orders        Order[]
  announcements Announcement[]
  deviceTokens  DeviceToken[]
}

/// An iOS device registered for notifications.
///
/// The token is the primary key because it identifies a device+install, not a
/// person: one pupil can have a phone and an iPad, and a reinstall issues a
/// fresh token for the same device. POST /push/register upserts on it, so a
/// phone that reissues its token does not leave a dead row behind.
model DeviceToken {
  token       String   @id
  studentId   String
  student     Account  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  platform    String // "ios"
  environment String // "production" | "sandbox" — decides the APNs host
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@index([studentId])
}

/// One dish that can appear on menus. Allergens keep the EU Annex II
/// display format ("1, 7") plus the "veg" tag, as printed in the UI.
model Meal {
  id        String       @id @default(cuid())
  name      String
  desc      String
  category  MealCategory
  allergens String[]
  icon      String
  tint      String // pastel category tint: t-peach, t-blue, t-green, t-lilac, t-cream

  servedOn MealOnDay[]
}

/// A school day: whether lunch is served (holidays = false).
/// There is no ordering deadline: isServing is the only thing that closes a
/// day, at any hour and on any date.
model SchoolDay {
  mealDate  DateTime @id // date at 00:00, local midnight
  isServing Boolean  @default(true)
  meals     MealOnDay[]
}

/// The real "menu for day X": manager enters which meals which slot.
/// `capacity` = kitchen portions (the fixture sums to 184).
/// `orderCount` = current number of ordered portions (a lock, not the capacity).
model MealOnDay {
  id         String   @id @default(cuid())
  mealDate   DateTime
  day        SchoolDay @relation(fields: [mealDate], references: [mealDate], onDelete: Cascade)
  mealId     String
  meal       Meal     @relation(fields: [mealId], references: [id])
  slot       Int // "Obed 1..9"
  capacity   Int      @default(0)
  orderCount Int      @default(0)
  orders     Order[]

  @@unique([mealDate, slot])
  @@index([mealDate])
}

/// A student's lunch order for one day. `mealDate` is denormalised from
/// MealOnDay so a partial unique index can enforce the business rule "one live
/// lunch per pupil per day" (a hop through MealOnDay cannot be the target of a
/// plain unique constraint). See the note on the constraint below for why the
/// old unique on (student, mealOnDay) had to go.
model Order {
  id          String      @id @default(cuid())
  studentId   String
  student     Account     @relation(fields: [studentId], references: [id])
  mealOnDayId String
  mealOnDay   MealOnDay   @relation(fields: [mealOnDayId], references: [id])
  mealDate    DateTime
  status      OrderStatus @default(ORDERED)
  createdAt   DateTime    @default(now())

  /// NO unique on (studentId, mealOnDayId). A cancelled order keeps its row —
  /// cancel sets status, it does not delete — so that constraint made every
  /// dish a pupil had ever cancelled today permanently unorderable: both
  /// `order.create` and the `mealOnDayId` update in PATCH collided with the
  /// dead row and surfaced as a raw 500.
  ///
  /// The rule that is actually wanted — one *active* order per pupil per day —
  /// is already enforced by "Order_one_live_order_per_student_day", created in
  /// migration 20260916090513_one_lunch_per_day. Prisma cannot express a
  /// partial unique index, so it does not appear here:
  ///
  ///   CREATE UNIQUE INDEX "Order_one_live_order_per_student_day"
  ///     ON "Order"("studentId", "mealDate")
  ///     WHERE "status" NOT IN ('CANCELLED', 'AUTO_CANCELLED');
  @@index([studentId])
  @@index([mealOnDayId])
  @@index([studentId, mealDate])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  important Boolean  @default(false)
  authorId  String
  author    Account  @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}