# Supabase (managed Postgres). Create a project, copy the connection string.
# The pooler (6543, pgbouncer=true) is for runtime; DIRECT_URL is for prisma migrate.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[your-ref].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[your-ref].supabase.co:5432/postgres

# Signing key for login JWTs. Generate with: openssl rand -hex 32
AUTH_SECRET=

# HTTP
PORT=3000
HOSTNAME=0.0.0.0
CORS_ORIGINS=*

# Ordering rules
# There is no ordering deadline and nothing to configure. A day is orderable
# whenever the canteen is cooking. DEFAULT_DEADLINE_HOUR no longer exists.
CLAIM_CODE_TTL_DAYS=7
LUNCH_PRICE_CENTS=550